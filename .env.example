# ==============================================================================
# PulseBoard Environment Variables
# ==============================================================================

# The Movie Database (TMDB v3) API Configuration
# Optional: If omitted, PulseBoard will automatically fall back to realistic,
# high-definition curated cinema mock data with zero disruption.
TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=

# NewsAPI Configuration
# Optional: If omitted, PulseBoard will automatically fall back to realistic,
# high-quality technology and world headlines.
NEWS_API_KEY=

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
